---
interface Heading {
  depth: number
  id: string
  text: string
}

const { headings } = props<{ headings: Heading[] }>()

const sections = () => headings.filter(heading => heading.depth === 2)
---
if sections().length >= 4
  nav.toc(aria-labelledby="toc-title")
    .toc-list
      h2#toc-title.mb-2.font-mono.text-sm.tracking-wide.text-muted.uppercase Contents
      ol
        for section of sections() key={section.id}
          li: a(href={`#${section.id}`}) {section.text}
