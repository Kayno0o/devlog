---
import { t } from 'kay/i18n'
import './toc.css'

interface Heading {
  depth: number
  id: string
  text: string
}

const { headings } = props<{ headings: Heading[] }>()

const sections = () => headings.filter(heading => heading.depth === 2)
---
if sections().length >= 4
  nav.toc(aria-labelledby="toc-title")
    .toc-list
      h2#toc-title.label.mb-3 {t('post.contents')}
      ol
        for section of sections() key={section.id}
          li: a(href={`#${section.id}`}) {section.text}
