---
import Astro from '~icons/simple-icons/astro'
import Next from '~icons/simple-icons/nextdotjs'
import Nuxt from '~icons/simple-icons/nuxt'
import Solid from '~icons/simple-icons/solid'
import Svelte from '~icons/simple-icons/svelte'
import { frameworkOf } from '../frameworks'
import kay from '../kay-logo.svg'

const { label } = props<{ label: string }>()

const logo = frameworkOf(label)
---
if logo === 'kay'
  img.size-4(src={kay} width="16" height="16" alt="")
else if logo === 'svelte'
  Svelte.size-4.shrink-0
else if logo === 'solid'
  Solid.size-4.shrink-0
else if logo === 'astro'
  Astro.size-4.shrink-0
else if logo === 'next'
  Next.size-4.shrink-0
else if logo === 'nuxt'
  Nuxt.size-4.shrink-0
