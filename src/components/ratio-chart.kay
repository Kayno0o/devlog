---
import type { BenchId } from '../benches'
import { benchSource } from '../benches'
import { formatNumber } from '../format'

interface Row {
  label: string
  unit: string
  kay: number
  against: string
  other: number
  better: 'lower' | 'higher'
  digits?: number | undefined
}

const { title, rows, bench, source } = props<{
  title: string
  rows: Row[]
  bench?: BenchId | undefined
  source?: string | undefined
}>()

// Bars run on one log scale from 1x to 100x in every chart, so a 1.2x lead looks the same size wherever it sits.
const scaleMax = Math.log(100)
const measured = rows.map((row) => {
  const ratio = row.better === 'lower' ? row.other / row.kay : row.kay / row.other

  return { ...row, wins: ratio >= 1, times: Math.max(ratio, 1 / ratio) }
})
const caption = bench === undefined ? source : benchSource(bench, source)
---
figure.chart
  figcaption.mb-3.flex.flex-wrap.items-baseline.justify-between.gap-x-4
    span.font-semibold {title}
    span.text-sm.text-muted log scale, 1x to 100x
  .flex.flex-col.gap-4(aria-hidden="true")
    for row, i of measured key={row.label}
      div
        .mb-1.flex.items-baseline.justify-between.gap-3
          span.text-sm.font-semibold {row.label}
          span.text-sm.font-semibold.tabular-nums {formatNumber(row.times)}x {row.wins ? 'better' : 'worse'}
        .chart-bar(class={{ 'chart-bar-highlight': row.wins }} style={`width: ${100 * Math.log(row.times) / scaleMax}%; --row: ${i}`})
        p.mt-1.text-xs.text-subtext.tabular-nums kay {formatNumber(row.kay, row.digits)} against {row.against}'s {formatNumber(row.other, row.digits)} {row.unit}, {row.better} is better
  table.sr-only
    thead
      tr
        th(scope="col") Measure
        th(scope="col") kay
        th(scope="col") Best of the others
        th(scope="col") Ratio
    tbody
      for row of measured key={row.label}
        tr
          th(scope="row") {row.label}
          td {formatNumber(row.kay, row.digits)} {row.unit}
          td {row.against}, {formatNumber(row.other, row.digits)} {row.unit}
          td {formatNumber(row.times)} times {row.wins ? 'better' : 'worse'}
  if caption
    p.mt-3.text-xs.text-muted Source: {caption}
