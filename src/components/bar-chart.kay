---
import type { BenchId } from '../benches'
import { benchSource } from '../benches'
import Astro from '~icons/simple-icons/astro'
import Solid from '~icons/simple-icons/solid'
import Svelte from '~icons/simple-icons/svelte'
import kay from '../kay-logo.png'
import { formatNumber } from '../format'

// A row is named by its framework, then maybe its site: `SvelteKit` or `Astro, painter`.
const logos = new Map([['kay', 'kay'], ['Svelte', 'svelte'], ['SvelteKit', 'svelte'], ['SolidJS', 'solid'], ['SolidStart', 'solid'], ['Astro', 'astro']])

interface Row {
  label: string
  value: number
}

const { title, unit, rows, highlight, better, bench, source, digits = 1 } = props<{
  title: string
  unit: string
  rows: Row[]
  highlight?: string | string[] | undefined
  better?: 'lower' | 'higher' | undefined
  bench?: BenchId | undefined
  source?: string | undefined
  digits?: number | undefined
}>()

// Without `highlight`, kay's own rows stand out: `kay`, or `kay, painter` when one chart compares several sites.
const highlighted = new Set(highlight === undefined ? rows.map(row => row.label).filter(label => label === 'kay' || label.startsWith('kay, ')) : [highlight].flat())
const caption = bench === undefined ? source : benchSource(bench, source)
const max = () => Math.max(...rows.map(row => row.value))
function logo(label: string) {
  const comma = label.indexOf(',')

  return logos.get(comma === -1 ? label : label.slice(0, comma))
}
---
figure.chart
  figcaption.mb-3.flex.flex-wrap.items-baseline.justify-between.gap-x-4
    span.font-semibold {title}
    if better
      span.text-sm.text-muted {better} is better
  div(class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-1.5 gap-y-1" aria-hidden="true")
    for row, i of rows key={row.label}
      span.flex.items-center.justify-end.gap-1.5.text-sm(class={{ 'font-semibold': highlighted.has(row.label), 'text-subtext': !highlighted.has(row.label) }})
        | {row.label}
        if logo(row.label) === 'kay'
          img.size-4(src={kay} sizes="16px" alt="")
        else if logo(row.label) === 'svelte'
          Svelte.size-4.shrink-0
        else if logo(row.label) === 'solid'
          Solid.size-4.shrink-0
        else if logo(row.label) === 'astro'
          Astro.size-4.shrink-0
      .flex.min-w-0.items-center.gap-2
        .chart-bar(class={{ 'chart-bar-highlight': highlighted.has(row.label) }} style={`width: calc((100% - 6rem) * ${row.value / max()}); --row: ${i}`})
        span.text-sm.whitespace-nowrap.tabular-nums {formatNumber(row.value, digits)} {unit}
  table.sr-only
    thead
      tr
        th(scope="col") Name
        th(scope="col") Value
    tbody
      for row of rows key={row.label}
        tr
          th(scope="row") {row.label}
          td {formatNumber(row.value, digits)} {unit}
  if caption
    p.mt-3.text-xs.text-muted Source: {caption}
