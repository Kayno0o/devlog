--- server
import { posts } from '../content.config'

const entries = await posts.all()
---
---
import { t, T } from 'kay/i18n'
import Github from '~icons/simple-icons/github'
import IconLink from '../components/icon-link.kay'
import PostMeta from '../components/post-meta.kay'
import kay from '../kay-logo.svg'
---
head
  title(raw) {t('home.title')}
.mx-auto.max-w-2xl
  section.mb-12
    h1.mb-3.text-3xl.font-semibold {t('home.greeting')}
    p.mb-3.text-subtext
      T(key="home.who")
        @about(text)
          a(href="/about") {text}
        @code(text)
          IconLink(href="https://github.com/Kayno0o" icon={Github}) {text}
    p.text-subtext
      T(key="home.notes")
        @kay(text)
          IconLink(href="https://kayjs.kaynooo.fr" image={kay}) {text}
  section(aria-labelledby="posts-title")
    h2#posts-title.mb-4.font-mono.text-sm.tracking-wide.text-muted.uppercase {t('home.posts')}
    ol.flex.flex-col.gap-6
      for post of entries key={post.slug}
        li
          a.group.block.no-underline(href={`/posts/${post.slug}`})
            PostMeta(date={post.data.date} file={post.file})
            h3.text-lg.font-semibold.group-hover:underline.group-hover:decoration-accent {post.data.title}
            p.text-subtext {post.data.description}
      else
        li.text-subtext {t('home.empty')}
