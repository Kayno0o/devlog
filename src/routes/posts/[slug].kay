--- server
import { posts } from '../../content.config'

export const prerender = posts

const post = await posts.get(ctx.params.slug) ?? ctx.notFound()
const { Content } = post
---
---
import ArrowLeft from '~icons/tabler/arrow-left'
import Pencil from '~icons/tabler/pencil'
import PostMeta from '../../components/post-meta.kay'
import Toc from '../../components/toc.kay'
---
head
  title {post.data.title}
  meta(name="description" content={post.data.description})
  meta(property="og:type" content="article")
  script(src="/charts.js" type="module")
article.relative.mx-auto.max-w-2xl
  a.mb-8.inline-flex.items-center.gap-1.text-sm(href="/")
    ArrowLeft.size-4
    | All posts
  header.mb-10
    h1.mb-3.text-3xl.font-semibold.text-balance {post.data.title}
    PostMeta(date={post.data.date} updated={post.data.updated} file={post.file} tags={post.data.tags})
  Toc(headings={post.headings})
  .prose
    Content
  footer.mt-12.border-t-2.border-surface.pt-4.text-sm.text-muted
    a.inline-flex.items-center.gap-1(href={`https://git.kaynooo.fr/kaynooo/devlog/src/branch/main/${post.file}`})
      Pencil.size-4
      | Suggest a fix to this post
