--- server
import { shareCard } from 'kay/image'
import { posts } from '../../content.config'
import kayCard from '../../kay-card.svg'

export const page = { prerender: posts }

const post = await posts.get(ctx.params.slug) ?? ctx.notFound()
const { Content } = post
// A post about kay shares a card with its logo in it.
const cardImage = post.data.tags.includes('kay') ? kayCard : undefined
--- script
import { t } from 'kay/i18n'
import ArrowLeft from '~icons/tabler/arrow-left'
import ArrowRight from '~icons/tabler/arrow-right'
import Pencil from '~icons/tabler/pencil'
import X from '~icons/tabler/x'
import PostMeta from '../../components/post-meta.kay'
import Toc from '../../components/toc.kay'
import '../../post.css'
---
head
  title {post.data.title}
  meta(name="description" content={post.data.description})
  meta(property="og:type" content="article")
  meta(property="og:image" content={shareCard({ title: post.data.title, image: cardImage })})
  script(src="/post.js" type="module")
article.relative.mx-auto.max-w-2xl
  a.mb-8.inline-flex.items-center.gap-1.text-sm.text-subtext.no-underline.hover:text-text(href="/")
    ArrowLeft.size-4
    | {t('post.all')}
  header.mb-10.flex.flex-col.gap-4.border-b.border-border.pb-8
    PostMeta(date={post.data.date} updated={post.data.updated} minutes={post.readingTime} tags={post.data.tags})
    h1.font-display.text-4xl.leading-tight.font-semibold.sm:text-5xl {post.data.title}
    p.text-lg.text-subtext {post.data.description}
  Toc(headings={post.headings})
  .prose
    Content
  footer.mt-12.border-t.border-border.pt-4.text-sm.text-muted
    a.inline-flex.items-center.gap-1(href={`https://github.com/Kayno0o/devlog/blob/main/${post.file}`})
      Pencil.size-4
      | {t('post.suggestFix')}
// post.js fills it with the image clicked, and steps through the post's images.
dialog.gallery(aria-label={t('post.gallery')})
  figure.gallery-figure
  .gallery-bar
    button.gallery-step(type="button" data-step="-1" aria-label={t('post.previousImage')})
      ArrowLeft.size-5
    span.gallery-count
    button.gallery-step(type="button" data-step="1" aria-label={t('post.nextImage')})
      ArrowRight.size-5
    button.gallery-close(type="button" aria-label={t('post.closeImage')})
      X.size-5
