---
import { t, T } from 'kay/i18n'
import Arch from '~icons/simple-icons/archlinux'
import Arduino from '~icons/simple-icons/arduino'
import Brave from '~icons/simple-icons/brave'
import Claude from '~icons/simple-icons/claude'
import Egg from '~icons/tabler/egg-filled'
import Eslint from '~icons/simple-icons/eslint'
import Fish from '~icons/simple-icons/fishshell'
import Forgejo from '~icons/simple-icons/forgejo'
import Github from '~icons/simple-icons/github'
import Godot from '~icons/simple-icons/godotengine'
import Mail from '~icons/tabler/mail'
import Manjaro from '~icons/simple-icons/manjaro'
import Mcp from '~icons/simple-icons/modelcontextprotocol'
import Nuxt from '~icons/simple-icons/nuxt'
import Php from '~icons/simple-icons/php'
import Plasma from '~icons/simple-icons/kdeplasma'
import Processing from '~icons/simple-icons/processingfoundation'
import Symfony from '~icons/simple-icons/symfony'
import Terminal from '~icons/tabler/terminal-2'
import Tmux from '~icons/simple-icons/tmux'
import Wayland from '~icons/simple-icons/wayland'
import IconLink from '../components/icon-link.kay'
---
head
  title {t('about.title')}
  meta(name="description" content={t('about.description')})
article.mx-auto.max-w-2xl
  h1.mb-10.text-3xl.font-semibold {t('about.title')}
  .prose
    p
      T(key="about.intro")
        @godot(text)
          IconLink(href="https://godotengine.org" icon={Godot}) {text}
    h2 {t('about.origins.title')}
    p
      T(key="about.origins.arduino")
        @arduino(text)
          IconLink(href="https://www.arduino.cc" icon={Arduino}) {text}
        @processing(text)
          IconLink(href="https://processing.org" icon={Processing}) {text}
    p {t('about.origins.school')}
    p
      T(key="about.origins.work")
        @dofus(text)
          IconLink(href="https://www.dofus.com" icon={Egg}) {text}
        @nuxt(text)
          IconLink(href="https://nuxt.com" icon={Nuxt}) {text}
        @symfony(text)
          IconLink(href="https://symfony.com" icon={Symfony}) {text}
    p
      T(key="about.origins.hosting")
        @forgejo(text)
          IconLink(href="https://forgejo.org" icon={Forgejo}) {text}
    h2 {t('about.values.title')}
    p {t('about.values.footprint')}
    p
      T(key="about.values.code")
        @eslint(text)
          IconLink(href="https://github.com/Kayno0o/eslint" icon={Eslint}) {text}
        @antfu(text)
          IconLink(href="https://github.com/antfu/eslint-config" icon={Github}) {text}
        @phpcs(text)
          IconLink(href="https://cs.symfony.com" icon={Php}) {text}
    h2 {t('about.setup.title')}
    p
      T(key="about.setup.claude")
        @claude(text)
          IconLink(href="https://claude.com/product/claude-code" icon={Claude}) {text}
        @mcp(text)
          IconLink(href="https://modelcontextprotocol.io" icon={Mcp}) {text}
    ul
      li
        T(key="about.setup.os")
          @arch(text)
            IconLink(href="https://archlinux.org" icon={Arch}) {text}
          @manjaro(text)
            IconLink(href="https://manjaro.org" icon={Manjaro}) {text}
      li
        T(key="about.setup.desktop")
          @plasma(text)
            IconLink(href="https://kde.org/plasma-desktop" icon={Plasma}) {text}
          @wayland(text)
            IconLink(href="https://wayland.freedesktop.org" icon={Wayland}) {text}
      li
        T(key="about.setup.terminal")
          @fish(text)
            IconLink(href="https://fishshell.com" icon={Fish}) {text}
          @kitty(text)
            IconLink(href="https://sw.kovidgoyal.net/kitty" icon={Terminal}) {text}
          @tmux(text)
            IconLink(href="https://github.com/tmux/tmux" icon={Tmux}) {text}
      li: IconLink(href="https://brave.com" icon={Brave}) Brave
    h2 {t('about.contact.title')}
    p
      T(key="about.contact.text")
        @repo(text)
          IconLink(href="https://github.com/Kayno0o/kayjs" icon={Github}) {text}
        @mail(text)
          IconLink(href="mailto:contact@kaynooo.fr" icon={Mail}) {text}
